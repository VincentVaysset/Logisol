// =====================================================================
// RÈGLES FIRESTORE — collections Logisol UNIQUEMENT
// =====================================================================
//
// ⚠️ POURQUOI LA SOLUTION ÉVIDENTE EST À PROSCRIRE ICI
//
// La règle qui vient naturellement à l'esprit pour « tout autoriser
// automatiquement » est :
//
//     match /{document=**} { allow read, write: if request.auth != null; }
//
// Elle est INAPPLICABLE sur ce projet. Les règles Firestore s'additionnent :
// dès qu'UNE règle autorise, l'accès est accordé, et aucune règle ne peut le
// reprendre. Or le projet ovilog-15ef6 héberge AUSSI Ovilog. Ce joker
// ouvrirait donc en lecture ET en écriture l'intégralité des collections
// d'Ovilog à toute personne connectée depuis Logisol — exactement
// l'interférence que Logisol doit s'interdire.
//
// ✅ LA SOLUTION RETENUE : un joker CADRÉ PAR UN PRÉFIXE DE NOM
//
// Le bloc « collections futures » ci-dessous autorise d'avance tout nom de
// collection commençant par "lgs_", sans jamais rien ouvrir d'autre. À partir
// de maintenant, toute nouvelle collection Logisol portera ce préfixe : elle
// fonctionnera immédiatement, sans que tu aies à revenir ici.
//
// Les collections existantes gardent leur nom (elles contiennent déjà des
// données réelles ; les renommer imposerait une migration risquée pour un
// gain nul) et sont listées explicitement une fois pour toutes.
//
// ⚠️ CE FICHIER N'EST PAS DÉPLOYÉ AUTOMATIQUEMENT, ET C'EST VOLONTAIRE.
// Déployer des règles depuis la CI écraserait le jeu de règles ENTIER du
// projet, donc celles d'Ovilog, qui ne figurent pas dans ce dépôt. Aucune
// automatisation ne peut contourner ça sans risquer de casser Ovilog : le
// déploiement reste un copier-coller manuel dans la console Firebase.
// Ce fichier est fait pour n'avoir à le faire qu'UNE DERNIÈRE FOIS.
//
// ---------------------------------------------------------------------
// MODE D'EMPLOI (une seule fois)
// Console Firebase > Firestore Database > Règles. Colle le bloc ci-dessous
// À CÔTÉ des règles d'Ovilog, à l'intérieur du même
// `match /databases/{database}/documents { ... }`. Ne supprime rien.
// ---------------------------------------------------------------------

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================= COLLECTIONS FUTURES (rien à faire) =============
    // Tout nom commençant par "lgs_" est autorisé d'avance. C'est ce bloc
    // qui supprime le besoin de revenir ici à chaque nouveau module.
    match /{collection}/{docId} {
      allow read, write: if request.auth != null && collection.matches('^lgs_.*');
    }
    // Idem pour leurs sous-collections éventuelles.
    match /{collection}/{docId}/{sub=**} {
      allow read, write: if request.auth != null && collection.matches('^lgs_.*');
    }

    // ================= COLLECTIONS EXISTANTES =========================
    // Parcellaire
    match /parcelles/{docId}             { allow read, write: if request.auth != null; }
    match /parcelles_config/{docId}      { allow read, write: if request.auth != null; }
    match /cultures_config/{docId}       { allow read, write: if request.auth != null; }
    match /implantations/{docId}         { allow read, write: if request.auth != null; }
    match /assolements/{docId}           { allow read, write: if request.auth != null; }

    // Journal d'interventions
    match /interventions/{docId}         { allow read, write: if request.auth != null; }
    match /interventions_types/{docId}   { allow read, write: if request.auth != null; }

    // Stocks et alimentation
    match /stocks/{docId}                { allow read, write: if request.auth != null; }
    match /stades_config/{docId}         { allow read, write: if request.auth != null; }
    match /lots_animaux/{docId}          { allow read, write: if request.auth != null; }
    match /prelevements/{docId}          { allow read, write: if request.auth != null; }

    // Bâtiments, mouvements de stock et parc matériel : ces collections ont
    // été renommées avec le préfixe lgs_ et sont donc déjà couvertes par le
    // bloc « collections futures » ci-dessus. Rien à ajouter ici, ni
    // maintenant ni pour les prochains modules.
    //   lgs_batiments, lgs_cellules_grain, lgs_emplacements_fourrage,
    //   lgs_mouvements_stock, lgs_materiel
  }
}
