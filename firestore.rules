// Règles de sécurité pour les collections Logisol UNIQUEMENT.
//
// ⚠️ Ce fichier n'est PAS déployé automatiquement (aucune CI de ce dépôt ne
// touche aux règles Firestore, volontairement — voir README). Le projet
// Firebase "ovilog-15ef6" est partagé avec l'appli Ovilog, qui a ses propres
// règles pour ses propres collections. Firestore n'ayant qu'un seul jeu de
// règles par projet, tu dois AJOUTER le bloc "parcelles" / "parcelles_config"
// ci-dessous aux règles existantes dans la console Firebase, sans toucher
// au reste (règles d'Ovilog).
//
// rules_version = '2';
// service cloud.firestore {
//   match /databases/{database}/documents {
//
//     // --- Règles existantes d'Ovilog : NE PAS MODIFIER depuis ce fichier ---
//     // match /brebis/{id} { ... }
//     // match /... { ... }
//
//     // --- Bloc à ajouter pour Logisol ---
//     match /parcelles/{parcelleId} {
//       allow read, write: if request.auth != null;
//     }
//     match /parcelles_config/{docId} {
//       allow read, write: if request.auth != null;
//     }
//     match /cultures_config/{docId} {
//       allow read, write: if request.auth != null;
//     }
//     match /assolements/{docId} {
//       allow read, write: if request.auth != null;
//     }
//     match /implantations/{docId} {
//       allow read, write: if request.auth != null;
//     }
//     match /interventions/{docId} {
//       allow read, write: if request.auth != null;
//     }
//     match /interventions_types/{docId} {
//       allow read, write: if request.auth != null;
//     }
//     match /stocks/{docId}        { allow read, write: if request.auth != null; }
//     match /stades_config/{docId} { allow read, write: if request.auth != null; }
//     match /lots_animaux/{docId}  { allow read, write: if request.auth != null; }
//     match /prelevements/{docId}  { allow read, write: if request.auth != null; }
//   }
// }

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /parcelles/{parcelleId} {
      allow read, write: if request.auth != null;
    }
    // parcelles_config (ancien typeUsage) : obsolète depuis le passage aux
    // assolements/cultures ci-dessous, mais laissé en place — inoffensif si
    // déjà collé, et évite d'imposer une manipulation supplémentaire.
    match /parcelles_config/{docId} {
      allow read, write: if request.auth != null;
    }
    match /cultures_config/{docId} {
      allow read, write: if request.auth != null;
    }
    // assolements : ancien modèle (une culture par année civile), remplacé
    // par "implantations". Conservé le temps de la reprise automatique, qui
    // marque chaque document repris.
    match /assolements/{docId} {
      allow read, write: if request.auth != null;
    }

    // --- Ajouts du lot « journal d'interventions » ---
    // Une culture est une PÉRIODE (semis -> fin), pas une année civile.
    match /implantations/{docId} {
      allow read, write: if request.auth != null;
    }
    // Journal des interventions : une intervention peut porter sur plusieurs
    // parcelles à la fois.
    match /interventions/{docId} {
      allow read, write: if request.auth != null;
    }
    // Types d'intervention : liste prédéfinie + types personnalisés.
    match /interventions_types/{docId} {
      allow read, write: if request.auth != null;
    }
    // --- Ajouts du lot « stocks + alimentation » ---
    // Récoltes saisies parcelle par parcelle.
    match /stocks/{docId} {
      allow read, write: if request.auth != null;
    }
    // Stades physiologiques et leur ration journalière par brebis.
    match /stades_config/{docId} {
      allow read, write: if request.auth != null;
    }
    // Lots d'animaux (groupe de brebis au même stade, nourries ensemble).
    match /lots_animaux/{docId} {
      allow read, write: if request.auth != null;
    }
    // Périodes de prélèvement d'un lot sur une catégorie de stock.
    match /prelevements/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
